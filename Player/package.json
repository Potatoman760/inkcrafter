{
  "name": "inkcrafter-player",
  "version": "0.1.0",
  "description": "A web player for InkCrafter bundles — a visual-novel engine built on Phaser 4 and Ink.",
  "author": "InkCrafter",
  "main": "desktop-dist/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/play.mjs dev",
    "build": "npm run spec:check && tsc --noEmit && node scripts/play.mjs build",
    "preview": "node scripts/play.mjs preview",
    "games": "node scripts/play.mjs list",
    "typecheck": "tsc --noEmit",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run desktop:compile && node scripts/desktop-dev.mjs",
    "desktop:pack": "node scripts/desktop-build.mjs --dir",
    "desktop:dist": "node scripts/desktop-build.mjs --installer"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  }
}
