# Dependencies
node_modules/

# Build output
dist/
desktop-dist/
release/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Private release keys installed by InkCrafter and embedded only at build time.
.inkcrafter/
steam_appid.txt

# Claude Code's local settings. Add a negation here if something under
# `.claude/` ever needs sharing.
.claude/

# Exported games. Each is a build output of the *editor*, not source: it is
# written whole by `Export for Player…` and can be re-exported at any time, so
# tracking it means committing megabytes of media on every story edit. The
# folder itself stays, with its README.
game/*/
